# Doxyfile for hipObject
# Generated from docs/Doxyfile.in by CMake
#
# Doxygen generates XML consumed by Breathe; Sphinx
# produces the final HTML output.

PROJECT_NAME           = "@PROJECT_NAME@"
PROJECT_NUMBER         = "@PROJECT_VERSION@"
PROJECT_BRIEF          = \
  "RDMA-accelerated S3 object storage for GPUs"

OUTPUT_DIRECTORY       = "@HIPOBJ_DOC_PATH@"
INPUT                  = "@HIPOBJ_DOXYFILE_INPUT@"
RECURSIVE              = YES
FILE_PATTERNS          = *.h

EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = YES

# XML output for Breathe (Sphinx integration)
GENERATE_HTML          = NO
GENERATE_LATEX         = NO
GENERATE_XML           = YES
XML_OUTPUT             = xml
XML_PROGRAMLISTING     = YES

# Warning settings
QUIET                  = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_IF_DOC_ERROR      = YES
WARN_AS_ERROR          = FAIL_ON_WARNINGS
WARN_NO_PARAMDOC       = NO

# Preprocessing (needed for visibility attrs)
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
PREDEFINED             = HIPOBJ_API= \
                         __attribute__(x)=

# Thread-safety tags. Every function in the public header has
# one of them; test/thread-safety/check_thread_safety_tags.py
# checks that, and that they match what the code does. The
# "threads" group in hipobj.h explains both. ^^ is a newline.
ALIASES                = "serialized=@par Thread safety^^Serialized: runs one at a time with the other serialized functions, and returns hipObjInvalidValue if called from a callback. See @ref threads." \
                         "concurrent=@par Thread safety^^Concurrent: can be called from any thread at any time, including from a callback, as long as calls that run at the same time don't share a buffer that one of them writes to or a token that one of them releases. See @ref threads."

# The hipobj-rc-v2 API surface in hipobj.h is gated on
# HIPOBJECT_V2_API. CMake appends a "PREDEFINED +=" line
# here when that build option is on (the default), so the
# v2 declarations stay in the generated reference.
@HIPOBJ_DOXYGEN_PREDEFINED@

# Source browsing (available via Breathe)
SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
STRIP_CODE_COMMENTS    = YES

# Diagrams
HAVE_DOT               = NO

# Sorting
SORT_MEMBER_DOCS       = YES
SORT_BRIEF_DOCS        = YES

# C-oriented output
OPTIMIZE_OUTPUT_FOR_C  = YES
TYPEDEF_HIDES_STRUCT   = NO
SHOW_INCLUDE_FILES     = YES
