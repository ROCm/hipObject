# Doxyfile for hipObject
#
# Doxygen generates XML consumed by Breathe; Sphinx
# produces the final HTML output.
#
# Run doxygen in this directory, which the relative
# paths below are from. That writes the XML into
# xml/, where docs/conf.py looks for it. The CMake
# build includes this file from one of its own that
# sends the output to the build directory instead
# (see cmake/HIPOBJDocumentation.cmake).

PROJECT_NAME           = "hipobj"
PROJECT_BRIEF          = \
  "RDMA-accelerated S3 object storage for GPUs"

OUTPUT_DIRECTORY       = .
INPUT                  = ../../include
RECURSIVE              = YES
FILE_PATTERNS          = *.h
# Name the files from the repository's root
# (include/hipobj.h), not from here
STRIP_FROM_PATH        = ../..

EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = YES

# XML output for Breathe (Sphinx integration)
GENERATE_HTML          = NO
GENERATE_LATEX         = NO
GENERATE_XML           = YES
XML_OUTPUT             = xml
XML_PROGRAMLISTING     = YES

# Warning settings
QUIET                  = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_IF_DOC_ERROR      = YES
WARN_AS_ERROR          = FAIL_ON_WARNINGS
WARN_NO_PARAMDOC       = NO

# Preprocessing (needed for visibility attrs)
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
PREDEFINED             = HIPOBJ_API= \
                         __attribute__(x)=

# Source browsing (available via Breathe)
SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
STRIP_CODE_COMMENTS    = YES

# Diagrams
HAVE_DOT               = NO

# Sorting
SORT_MEMBER_DOCS       = YES
SORT_BRIEF_DOCS        = YES

# C-oriented output
OPTIMIZE_OUTPUT_FOR_C  = YES
TYPEDEF_HIDES_STRUCT   = NO
SHOW_INCLUDE_FILES     = YES
