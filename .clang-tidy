# clang-tidy configuration for hipObject
#
# Build with -DHIPOBJ_USE_CLANG_TIDY=ON (and Clang as the C++ compiler)
# to run these checks. Every finding is an error.
#
# The checks lean toward security and modern C++: whole groups are
# enabled, and individual checks are turned off below. Later entries
# override earlier ones.
#
# This needs clang-tidy 19 or later, for ExcludeHeaderFilterRegex. CI
# (hipobject-clang-tidy.yml) uses upstream clang-tidy 23. ROCm's
# clang-tidy works, but it's built without the clang-analyzer-* checks.
#
# Some checks have more than one name (aliases), and some were renamed
# between LLVM releases (hicpp-signed-bitwise became
# bugprone-signed-bitwise), so a check that's turned off is listed under
# each of its names. Each alias follows the check it's an alias of.
---
Checks:
  - -*
  # android-cloexec-socket reports nothing with glibc's headers, so
  # socket() calls need SOCK_CLOEXEC without its help
  - android-cloexec-*
  - bugprone-*
  - cert-*
  - clang-analyzer-*
  - concurrency-*
  - cppcoreguidelines-*
  - google-explicit-constructor
  - google-runtime-int
  # LLVM 23 removed the hicpp checks, and these moved to the bugprone
  # and portability groups
  - hicpp-exception-baseclass
  - hicpp-ignored-remove-result
  - hicpp-multiway-paths-covered
  - hicpp-no-assembler
  - hicpp-signed-bitwise
  - misc-*
  - modernize-*
  - performance-*
  - portability-*
  - readability-*

  # Not wanted: style-only checks that contradict hipObject's
  # conventions or tooling, and checks whose fixes would make the code
  # worse than what the build already does. Turn them on now and then,
  # such as before a release, and fix whatever they report that's easy to
  # fix, without committing to fixing all of it

  # IWYU checks the includes, and its suggestions are advisory
  - -misc-include-cleaner
  # Every header uses #pragma once, as hipFile's do
  - -portability-avoid-pragma-once
  - -readability-identifier-length
  - -modernize-use-trailing-return-type
  # Its fix, return {...}, can call a different constructor than the
  # explicit call it replaces: braces prefer an initializer_list
  # constructor, as std::string and std::vector have
  - -modernize-return-braced-init-list
  # GCC's -Weffc++ wants every member initialized in the constructor's
  # initializer list or in its declaration, and this check reports exactly
  # those initializers as redundant, so the two can't both pass
  - -readability-redundant-member-init
  # It reports every enum whose values fit in a smaller type than int,
  # whether or not its size matters. hipObject's enums aren't sent over
  # the wire or kept in large arrays, and padding takes up most of what a
  # smaller type would save in a struct
  - -performance-enum-size
  # They report operator[] on std::array, std::vector, std::span, and the
  # like, and want at(). Every build defines _GLIBCXX_ASSERTIONS, so
  # libstdc++ bounds-checks operator[] and aborts on a bad index, and C
  # arrays are already reported by modernize-avoid-c-arrays and
  # -Wunsafe-buffer-usage. An index that comes from the network has to be
  # checked where it arrives, and rejected with an error, so a bad one
  # that gets this far is a bug in hipObject. Stopping is safer than
  # what at() would do: throw, have the C API turn the exception into
  # hipObjInternalError, and carry on past the broken invariant. at() also
  # adds an exception path to the hot path's loops
  - -cppcoreguidelines-pro-bounds-avoid-unchecked-container-access
  - -cppcoreguidelines-pro-bounds-constant-array-index
  # It reports every function with adjacent parameters of the same type,
  # such as a pair of sizes or addresses. Telling them apart would take a
  # separate type for each, which would make those functions harder to
  # call without catching anything the names and the tests don't
  - -bugprone-easily-swappable-parameters
  # It reports a catch block that only holds a comment. hipObject's empty
  # catch blocks are deliberate, such as printTo()'s, which has nowhere
  # left to report a failure, and each says why it's empty
  - -bugprone-empty-catch
  # It reports zero-initializing an enum, or a struct holding one, whose
  # enumerators don't include 0, such as libibverbs' ibv_mtu and
  # ibv_qp_type. hipObject zeroes every libibverbs struct before filling it
  # in (see AGENTS.md), and sets the fields it uses
  - -bugprone-invalid-enum-default-initialization
  # It reports the examples' memcpy() of an x-amz-rdma-reply value, which
  # is length-delimited and needs no NUL
  - -bugprone-not-null-terminated-result
  # It reports bitwise operations on signed integers, and libibverbs'
  # flags and attribute masks are int enumerators that its functions take
  # as int, so every combination of them would need casts
  - -bugprone-signed-bitwise
  - -hicpp-signed-bitwise

  # TODO: These checks report problems in the current code. Fix the code
  # and delete the check's line here, or move it to "Not wanted" with a
  # reason. The count is the number of places clang-tidy 23 reports.
  - -readability-function-cognitive-complexity  # TODO(14)
WarningsAsErrors: '*'

CheckOptions:
  # std::from_chars takes an end pointer, so it never needs the
  # string_view's data() to be NUL-terminated
  bugprone-suspicious-stringview-data-usage.AllowedCallees: '::std::from_chars'
  # hipObject only builds with glibc, so report the functions that glibc
  # documents as thread-unsafe. The default adds POSIX's list, which
  # includes getenv() and dlerror(): glibc's getenv() only races with
  # changes to the environment, and its dlerror() keeps per-thread state.
  # Revisit this if hipObject is built with another C library.
  concurrency-mt-unsafe.FunctionSet: glibc
  # A mutable global in an anonymous namespace (or declared static) can
  # only be reached from its own file, so it doesn't couple distant code.
  # Hiding one in a function that returns a reference to a static local
  # would satisfy the check without changing that. Make such a variable
  # thread-safe (atomic, thread_local, or guarded by a lock), and constinit
  # where it's constant-initialized
  cppcoreguidelines-avoid-non-const-global-variables.AllowInternalLinkage: true
  # A lock guard is only declared for what its constructor and destructor
  # do, so const would say nothing about it
  misc-const-correctness.AllowedTypes: '::std::scoped_lock'
  # A class whose data members are all public is a struct, a set of values
  # with no invariant to protect, even with a constructor, so only mixed
  # and protected data are reported, as the cppcoreguidelines alias of
  # this check does by default
  misc-non-private-member-variables-in-classes.IgnoreClassesWithAllMemberVariablesBeingPublic: true
  # The default, Remove, mistakes the comma after an empty {} argument for
  # a trailing comma, as in {a, b, {}, c}, and its fix doesn't compile.
  # Multi-line lists still need a trailing comma, which also keeps
  # clang-format from packing several elements onto a line
  readability-trailing-comma.SingleLineCommaPolicy: Ignore
  # curl.h defines these as macros that expand to themselves, which trips
  # Clang's -Wdisabled-macro-expansion, so the examples parenthesize the
  # names to call the functions directly. std::max and std::min are the
  # default
  readability-redundant-parentheses.AllowedDecls: 'std::max;std::min;curl_easy_getinfo;curl_easy_setopt'

# Report problems in every header that isn't a system header, except:
#   - Third-party code that FetchContent pulls into the build directory
#   - The public header, which is C (C++ checks don't apply to it)
#   - ibv-core.h, which is derived from rocSHMEM and mirrors libibverbs'
#     C ABI, so it can't use enum class, constexpr, and the like
HeaderFilterRegex: '.*'
ExcludeHeaderFilterRegex: '.*/(_deps/.*|include/hipobj\.h|src/common/ibv-core\.h)$'
SystemHeaders: false
