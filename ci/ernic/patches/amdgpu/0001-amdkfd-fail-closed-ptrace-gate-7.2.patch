Subject: [PATCH] amdkfd: fail closed on the ptrace gate for kernels >= 7.2

--- a/amd/amdkfd/kfd_process_queue_manager.c
+++ b/amd/amdkfd/kfd_process_queue_manager.c
@@ -29,6 +29,7 @@
 #include <linux/user_namespace.h>	/* get_user_ns, put_user_ns */
 #include <linux/sched/mm.h>	/* get_task_mm, mmput */
 #include <linux/sched/signal.h>	/* same_thread_group */
+#include <linux/version.h>
 #include <linux/sched/coredump.h>	/* get_dumpable, SUID_DUMP_USER */
 #include "kfd_device_queue_manager.h"
 #include "kfd_priv.h"
@@ -867,11 +868,26 @@
 		put_user_ns(tcred_ns);
 		return -ESRCH;
 	}
+#if LINUX_VERSION_CODE < KERNEL_VERSION(7, 2, 0)
 	if (get_dumpable(mm) != SUID_DUMP_USER &&
 	    !ns_capable(mm->user_ns, CAP_SYS_PTRACE)) {
 		mmput(mm);
 		goto deny;
 	}
+#else
+	/*
+	 * 7.2 moved dumpability and the exec-time user_ns off mm_struct onto
+	 * task->exec_state, and neither task_exec_state_get_dumpable() nor
+	 * task_exec_state_rcu() is exported, so an out-of-tree driver cannot
+	 * read either. Fail closed: treat the target as non-dumpable and
+	 * require CAP_SYS_PTRACE unconditionally. Strictly no weaker than the
+	 * gate above -- it only denies what the in-tree check would allow.
+	 */
+	if (!ns_capable(tcred_ns, CAP_SYS_PTRACE)) {
+		mmput(mm);
+		goto deny;
+	}
+#endif
 	mmput(mm);
 	put_user_ns(tcred_ns);
 
