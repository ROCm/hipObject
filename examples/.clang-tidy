# clang-tidy configuration for the examples
#
# The examples are written to C++11 (see AGENTS.md), but the build
# compiles them as C++20, so clang-tidy would suggest newer constructs.
# This turns off the checks whose fixes need C++14 or later, and one
# that older versions of clang-tidy get wrong (below). It also keeps
# misc-const-correctness off parameters, so the examples don't need
# suppressions, and otherwise uses the top-level configuration.
---
InheritParentConfig: true
Checks:
  - -modernize-concat-nested-namespaces
  - -modernize-make-unique
  - -modernize-type-traits
  - -modernize-unary-static-assert
  - -modernize-use-constraints
  - -modernize-use-designated-initializers
  - -modernize-use-integer-sign-comparison
  - -modernize-use-nodiscard
  - -modernize-use-ranges
  - -modernize-use-scoped-lock
  - -modernize-use-starts-ends-with
  - -modernize-use-std-bit
  - -modernize-use-std-format
  - -modernize-use-std-numbers
  - -modernize-use-std-print
  - -modernize-use-string-view
  - -modernize-use-structured-binding
  - -modernize-use-transparent-functors
  - -modernize-use-uncaught-exceptions
  - -readability-container-contains
  # clang-tidy 20 and 21 report the typedef in s3_curl_ops.h, which C
  # includes too, so it can't be a using declaration. Later versions skip
  # typedefs inside extern "C".
  - -modernize-use-using

CheckOptions:
  # Callbacks have to match the prototypes libraries give them, such as
  # libcurl's CURLOPT_HEADERFUNCTION, which takes a pointer to non-const
  # it only reads
  misc-const-correctness.AnalyzeParameters: false
