@PACKAGE_INIT@

# The static library's target links hip::host and
# hsa-runtime64::hsa-runtime64, so they have to be defined before the
# targets file is loaded. The shared library records these dependencies
# itself and its target doesn't refer to them.
set(_hipobj_library_type "@HIPOBJ_LIBRARY_TYPE@")
if(_hipobj_library_type STREQUAL "STATIC_LIBRARY")
  include(CMakeFindDependencyMacro)
  find_dependency(hip CONFIG)
  find_dependency(hsa-runtime64 CONFIG)
endif()
unset(_hipobj_library_type)

include("${CMAKE_CURRENT_LIST_DIR}/hipobj-targets.cmake")

check_required_components(hipobj)
